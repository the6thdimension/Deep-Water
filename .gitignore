# Ignore Unity cache and build files
#/Assets/FDS Assets/Naval Vessels/
/Library/
/Temp/
/Logs/
/obj/
/Build/
/Builds/
.codegpt
.git_backup
/Packages/com.esri.arcgis-maps-sdk/


# Ignore user-specific settings
/UserSettings/
/*.csproj
/*.sln

# Track .meta files (important)
!Assets/**/*.meta
# autonomous routine local config
tools/ci/unity-path.txt
tools/ci/logs/

# IDE solution files (Unity regenerates them)
/*.slnx

# Crash dumps
*.stackdump

# FR2 (Find Reference 2) cache - regenerated by the plugin, churns on every edit
/Assets/FR2_Cache.asset
/Assets/FR2_Cache.asset.meta

# Secrets - never commit keys
/DeepWaterKey
/DeepWaterKey.pub
id_rsa*
id_ed25519*
*.pem

# Paid Asset Store pack (DAVFX): licence forbids redistribution - import it locally on each machine
/Assets/DAVFX/
/Assets/DAVFX.meta

# Claude scheduled-task runtime lock
.claude/scheduled_tasks.lock

# Unity Version Control (Plastic) workspace metadata: git is this project's version control (BUILD-SPEED-LEDGER round 1)
/.plastic/
/.plastic.pre-*/

# ML-Agents training output (RH Aviator, Dogfight Training): run logs, checkpoints, TensorBoard summaries.
# A kept policy is copied into Assets/RH Aviator/Policies/ with its settings (TRAINING-CONCEPT M19).
/Training/results/
/Assets/ML-Agents/Timers/*.json
/Assets/ML-Agents/Timers/*.json.meta
# The latest trained brain, copied here after each auto-train session (RH Aviator A18, M34): it changes every session.
# A brain worth keeping is saved to Assets/RH Aviator/Policies/Kept/ with its record, and committed (M19).
/Assets/RH Aviator/Policies/Latest/
/Assets/RH Aviator/Policies/Latest.meta
